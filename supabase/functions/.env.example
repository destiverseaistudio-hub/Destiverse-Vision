# Server-only Edge Function configuration. Copy to .env for local development;
# set production values with `supabase secrets set`, never commit real values.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Use a Gemini model enabled for Files API/video understanding. It may differ
# from the text-only assistant model above.
GEMINI_REEL_REVIEW_MODEL=gemini-3.5-flash-lite
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:destiverseaistudio@gmail.com
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
