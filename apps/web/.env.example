VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_VAPID_PUBLIC_KEY=
VITE_ENABLE_UPDATE_TEST_MODE=false
# Native Android AdMob defaults to Google's test banner. Set this to false only
# after the production app is approved and the live unit is ready to serve.
VITE_ADMOB_USE_TEST_ADS=true
# Cloudflare Stream credentials belong in Supabase Edge Function secrets only:
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_STREAM_API_TOKEN=
# For phone notifications, configure server-only Supabase secrets:
# VAPID_PUBLIC_KEY= (same value as VITE_VAPID_PUBLIC_KEY)
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:your-support-email@example.com
